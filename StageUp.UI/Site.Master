<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="StageUp.UI.SiteMaster" %>

<!DOCTYPE html>
<html id="HtmlRoot" runat="server" lang="es">
<head id="Head1" runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">StageUp</asp:ContentPlaceHolder></title>
    <link rel="icon" type="image/png" href="<%= ResolveUrl("~/Content/Images/favicon.png") %>" />
    <link id="SiteStyles" href="<%= ResolveUrl("~/Content/Css/site.css") %>?v=20261008-15" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <a class="skip-link" href="#main-content" data-i18n="General_SaltarContenido">Saltar al contenido principal</a>

        <header class="site-header">
            <div class="navbar container-wide">
                <a id="BrandLink" runat="server" class="brand" href="~/Default.aspx" aria-label="StageUp - Inicio">
                    <asp:Image ID="NavbarLogo" runat="server" CssClass="brand-logo" ImageUrl="~/Content/Images/stageup-isotipo.png" AlternateText="" />
                    <span class="brand-name">StageUp</span>
                </a>

                <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="public-navigation" data-nav-toggle>
                    <span class="sr-only" data-i18n="General_AbrirNavegacion">Abrir navegación</span>
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <div id="public-navigation" class="navbar-panel" data-nav-panel>
                    <nav class="primary-navigation" aria-label="Navegación principal">
                        <a id="ExploreLink" runat="server" class="nav-link" href="~/Explorar/ResultadosBusqueda.aspx" data-i18n="Nav_ExplorarEspacios">Explorar espacios</a>
                        <a id="NewsLink" runat="server" class="nav-link" href="~/Novedades.aspx">Novedades</a>
                        <a id="EncuestasLink" runat="server" class="nav-link" href="~/Encuestas.aspx">Encuestas</a>
                        <a id="HelpLink" runat="server" class="nav-link" href="~/Ayuda/CentroAyuda.aspx" data-i18n="Nav_Ayuda">Ayuda</a>
                        <a id="SearchLink" runat="server" class="nav-link" href="~/Buscar.aspx">Buscar</a>
                    </nav>

                    <div id="LanguageSelector" runat="server" class="language-selector">
                        <label for="<%= ddlIdioma.ClientID %>" data-i18n="General_Idioma">Idioma</label>
                        <asp:DropDownList ID="ddlIdioma" runat="server" CssClass="language-select" AutoPostBack="true"
                            DataTextField="NombreIdioma" DataValueField="IdIdioma" aria-label="Seleccionar idioma" data-i18n-skip="true" />
                    </div>

                    <div id="PublicActions" runat="server" class="public-actions">
                        <a id="LoginLink" runat="server" class="button button-ghost button-small" href="~/IniciarSesion.aspx" data-i18n="Nav_IniciarSesion">Iniciar sesión</a>
                        <a id="RegisterLink" runat="server" class="button button-primary button-small" href="~/Registrarse.aspx" data-i18n="Auth_Registrarse">Registrarse</a>
                    </div>

                    <div id="AuthenticatedTools" runat="server" class="authenticated-tools">
                        <div class="notifications-menu" data-notifications-menu>
                            <button type="button" class="auth-tool notifications-trigger" aria-expanded="false" aria-controls="notifications-panel" aria-label="Notificaciones" title="Notificaciones" data-notifications-trigger>
                                <span class="auth-tool-icon notifications-bell" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" focusable="false">
                                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                                        <path d="M10 21h4"></path>
                                    </svg>
                                </span>
                                <span class="sr-only" data-i18n="Nav_Notificaciones">Notificaciones</span>
                                <asp:Literal ID="litNotificacionesCount" runat="server" />
                            </button>
                            <section id="notifications-panel" class="notifications-panel" hidden data-notifications-panel aria-label="Notificaciones">
                                <header class="notifications-header">
                                    <div>
                                        <strong>Notificaciones</strong>
                                        <span>Actividad reciente de StageUp</span>
                                    </div>
                                    <asp:LinkButton ID="lnkMarcarTodasLeidas" runat="server" CssClass="notifications-mark-all" CausesValidation="false"
                                        Text="Marcar leídas" OnClick="lnkMarcarTodasLeidas_Click" />
                                </header>
                                <div class="notifications-list">
                                    <asp:Repeater ID="rptNotificaciones" runat="server" OnItemCommand="rptNotificaciones_ItemCommand">
                                        <ItemTemplate>
                                            <asp:LinkButton runat="server" CssClass='<%# "notification-item " + (Eval("Leida").Equals(true) ? "is-read" : "is-unread") %>'
                                                CausesValidation="false" CommandName="Ir" CommandArgument='<%# Eval("IdNotificacion") %>'>
                                                <span class="notification-state" aria-label='<%#: Eval("Leida").Equals(true) ? "Leída" : "No leída" %>'></span>
                                                <span class="notification-copy">
                                                    <strong><%#: Eval("Titulo") %></strong>
                                                    <span><%#: Eval("Mensaje") %></span>
                                                    <small><%#: StageUp.BLL.BLL_Notificacion.CategoriaPorTipo((string)Eval("Tipo")) + " · " + FormatearFechaNotificacion((DateTime)Eval("FechaCreacion")) + (Eval("Leida").Equals(true) ? string.Empty : " · Nueva") %></small>
                                                </span>
                                            </asp:LinkButton>
                                        </ItemTemplate>
                                    </asp:Repeater>
                                    <asp:Panel ID="pnlSinNotificaciones" runat="server" Visible="false" CssClass="notification-empty" style="padding: 18px; text-align: center; color: var(--color-text-muted);">
                                        <span>Todavía no tenés notificaciones.</span>
                                    </asp:Panel>
                                </div>
                                <footer class="notifications-footer">
                                    <asp:HyperLink ID="lnkVerTodasNotificaciones" runat="server" NavigateUrl="~/Notificaciones.aspx" Text="Ver todas" />
                                </footer>
                            </section>
                        </div>
                        <a id="ProfileHeaderLink" runat="server" class="auth-tool user-profile-link" href="~/MiPerfil.aspx" aria-label="Ir a Mi perfil" title="Mi perfil">
                            <span class="auth-tool-icon user-profile-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false">
                                    <circle cx="12" cy="8" r="4"></circle>
                                    <path d="M4.5 20c.8-4 3.3-6 7.5-6s6.7 2 7.5 6"></path>
                                </svg>
                            </span>
                            <span id="UserSummary" runat="server" class="user-profile-name"></span>
                        </a>
                        <asp:LinkButton ID="lnkCerrarSesion" runat="server" CssClass="auth-tool logout-tool" CausesValidation="false"
                            OnClick="lnkCerrarSesion_Click" aria-label="Cerrar sesión" title="Cerrar sesión">
                            <span class="auth-tool-icon logout-tool-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false">
                                    <path d="M12 3v9"></path>
                                    <path d="M7.2 5.8a8 8 0 1 0 9.6 0"></path>
                                </svg>
                            </span>
                            <span class="sr-only" data-i18n="Nav_CerrarSesion">Cerrar sesión</span>
                        </asp:LinkButton>
                    </div>
                </div>
            </div>
        </header>

        <div class="app-shell">
            <aside id="AuthenticatedSidebar" runat="server" class="app-sidebar" aria-label="Navegación de usuario autenticado">
                <div class="sidebar-heading" data-i18n="Nav_MiStageUp">Mi StageUp</div>
                <nav class="sidebar-navigation">
                    <a id="MisReservasLink" runat="server" class="sidebar-link" href="~/MisReservas.aspx" data-i18n="Nav_MisReservas">Mis reservas</a>
                    <a id="MiCuentaCorrienteLink" runat="server" class="sidebar-link" href="~/MiCuentaCorriente.aspx">Mi cuenta corriente</a>
                    <a id="MisEspaciosLink" runat="server" class="sidebar-link" href="~/MisEspacios.aspx" data-i18n="Nav_MisEspacios">Mis espacios</a>
                    <a id="MisActividadesLink" runat="server" class="sidebar-link" href="~/MisActividades.aspx" data-i18n="Nav_MisActividades">Mis actividades</a>
                    <a id="SoporteLink" runat="server" class="sidebar-link" href="~/Soporte.aspx">Soporte</a>
                </nav>
            </aside>

            <main id="main-content" class="page-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>

        <footer class="site-footer">
            <div class="footer-content container-wide">
                <div class="footer-brand">
                    <span class="footer-brand-name">StageUp</span>
                    <span class="footer-tagline" data-i18n="Footer_Lema">Encontrá tu espacio, potenciá tu arte.</span>
                </div>
                <nav class="footer-navigation" aria-label="Información legal">
                    <a id="AboutLink" runat="server" class="footer-link" href="~/QuienesSomos.aspx" data-i18n="Footer_QuienesSomos">Quiénes somos</a>
                    <a id="NewsFooterLink" runat="server" class="footer-link" href="~/Novedades.aspx">Novedades</a>
                    <a id="ContactLink" runat="server" class="footer-link" href="~/Contactenos.aspx" data-i18n="Footer_Contactenos">Contáctenos</a>
                    <a id="TermsLink" runat="server" class="footer-link" href="~/TerminosCondiciones.aspx" data-i18n="Footer_Terminos">Términos y condiciones</a>
                    <a id="PrivacyLink" runat="server" class="footer-link" href="~/PoliticaPrivacidad.aspx" data-i18n="Footer_Privacidad">Política de privacidad</a>
                </nav>
            </div>
        </footer>

        <asp:HiddenField ID="hdnDiccionarioIdioma" runat="server" ClientIDMode="Static" EnableViewState="false" />
        <asp:ContentPlaceHolder ID="PageScripts" runat="server" />
        <script src="<%= ResolveUrl("~/Scripts/site.js") %>?v=20260930-1"></script>
        <script src="<%= ResolveUrl("~/Scripts/multidioma.js") %>?v=20260910-2"></script>
        <script src="<%= ResolveUrl("~/Scripts/charts-stageup.js") %>?v=20261008-1"></script>
        <script src="<%= ResolveUrl("~/Scripts/ui-motion.js") %>?v=20261008-1"></script>
    </form>
</body>
</html>
