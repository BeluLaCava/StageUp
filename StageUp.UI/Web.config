<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Cadena de conexión a SQL Server local. Ajustar Data Source/Initial
    Catalog según el nombre real de la instancia y la base creada con
    Database/01_EsquemaSeguridadYRegistro.sql en cada máquina. Este valor
    es específico de la máquina de Julián: no pisarlo con el de otro
    integrante del equipo al sincronizar.
  -->
  <connectionStrings>
    <add name="StageUpConnectionString"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=StageUp;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="EspaciosFichaCompletaHabilitada" value="false" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPuerto" value="587" />
    <add key="SmtpUsarSsl" value="true" />
    <add key="SmtpUsuario" value="maria.belen.lacava@gmail.com" />
    <add key="SmtpPassword" value="ceslcuwmlappudo" />
    <add key="CorreoRemitente" value="maria.belen.lacava@gmail.com" />
    <add key="NombreRemitente" value="StageUp" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <sessionState mode="InProc" timeout="30" />
  </system.web>
</configuration>
