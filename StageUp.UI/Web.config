<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Cadena de conexión a SQL Server local. Ajustar Data Source/Initial
    Catalog según el nombre real de la instancia y la base creada con
    Database/01_EsquemaSeguridadYRegistro.sql en cada máquina.
  -->
  <connectionStrings>
    <add name="StageUpConnectionString"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=StageUp;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <!--
    Configuración de envío de correo (StageUp.Servicios.ServicioCorreo).
    Los valores de Usuario/Password son placeholders: hace falta cargar
    una cuenta de correo real del proyecto (se recomienda una cuenta de
    Gmail propia con contraseña de aplicación) para que el envío funcione.
    Mientras tanto, el sistema sigue funcionando: si el envío falla, cada
    caso de uso lo maneja como camino alternativo (ver BLL_UsuarioExterno).
  -->
  <appSettings>
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPuerto" value="587" />
    <add key="SmtpUsarSsl" value="true" />
    <add key="SmtpUsuario" value="COMPLETAR_CUENTA_DEL_PROYECTO@gmail.com" />
    <add key="SmtpPassword" value="COMPLETAR_CONTRASENA_DE_APLICACION" />
    <add key="CorreoRemitente" value="COMPLETAR_CUENTA_DEL_PROYECTO@gmail.com" />
    <add key="NombreRemitente" value="StageUp" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <sessionState mode="InProc" timeout="30" />
  </system.web>
</configuration>
