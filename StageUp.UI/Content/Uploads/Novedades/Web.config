<?xml version="1.0" encoding="utf-8"?>
<!-- Imágenes de novedades: IIS / IIS Express tienen que servir las WebP
     con su tipo (en algunas versiones .webp no viene registrado). -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
