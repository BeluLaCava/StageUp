<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
  <add name="StageUpConnectionString"
       connectionString="Data Source=BELUENVY\SQLEXPRESS01;Initial Catalog=StageUp;Integrated Security=True;TrustServerCertificate=True;"
       providerName="System.Data.SqlClient" />
</connectionStrings>
  <appSettings>
    <add key="EspaciosFichaCompletaHabilitada" value="false" />
	<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPuerto" value="587" />
    <add key="SmtpUsarSsl" value="true" />
    <add key="SmtpUsuario" value="COMPLETAR_CUENTA_DEL_PROYECTO@gmail.com" />
    <add key="SmtpPassword" value="COMPLETAR_CONTRASENA_DE_APLICACION" />
    <add key="CorreoRemitente" value="COMPLETAR_CUENTA_DEL_PROYECTO@gmail.com" />
    <add key="NombreRemitente" value="StageUp" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <sessionState mode="InProc" timeout="30" />
  </system.web>
</configuration>
