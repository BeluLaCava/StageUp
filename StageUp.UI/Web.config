<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Cadena de conexión a SQL Server local. 
  -->
	<connectionStrings>
		<add name="StageUpConnectionString"
                 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=StageUp;Integrated Security=True;TrustServerCertificate=True;"
                 providerName="System.Data.SqlClient" />
	</connectionStrings>
  <appSettings file="AppSettings.private.config">
    
    <add key="EspaciosFichaCompletaHabilitada" value="true" />
    <add key="PerfilCompletoHabilitado" value="true" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />

  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <sessionState mode="InProc" timeout="30" />
  </system.web>
</configuration>
