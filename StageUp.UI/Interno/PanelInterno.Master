<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PanelInterno.Master.cs" Inherits="StageUp.UI.Interno.PanelInterno" %>

<!DOCTYPE html>
<html id="HtmlRoot" runat="server" lang="es">
<head id="Head1" runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Panel administrativo | StageUp</asp:ContentPlaceHolder></title>
    <link rel="icon" type="image/png" href="<%= ResolveUrl("~/Content/Images/favicon.png") %>" />
    <link href="<%= ResolveUrl("~/Content/Css/site.css") %>?v=20261022-7" rel="stylesheet" />
</head>
<body class="internal-body">
    <form id="form1" runat="server">
        <header class="internal-header">
            <div class="internal-header-inner container-wide">
                <a class="internal-brand" href="~/Interno/PanelAdministrador.aspx" runat="server">
                    <span class="internal-brand-mark" aria-hidden="true">S</span>
                    <span class="internal-brand-copy">
                        <strong>StageUp</strong>
                        <small>Panel administrativo</small>
                    </span>
                </a>
                <div class="internal-session">
                    <div id="LanguageSelector" runat="server" class="language-selector internal-language-selector">
                        <label for="<%= ddlIdioma.ClientID %>" data-i18n="General_Idioma">Idioma</label>
                        <asp:DropDownList ID="ddlIdioma" runat="server" CssClass="language-select" AutoPostBack="true"
                            DataTextField="NombreIdioma" DataValueField="IdIdioma" aria-label="Seleccionar idioma" data-i18n-skip="true" />
                    </div>
                    <span id="InternalUserSummary" runat="server" class="internal-user-summary"></span>
                    <asp:LinkButton ID="lnkCerrarSesionInterna" runat="server" CssClass="internal-logout" CausesValidation="false"
                        Text="Cerrar sesión" OnClick="lnkCerrarSesionInterna_Click" />
                </div>
            </div>
        </header>

        <div class="internal-shell container-wide">
            <nav class="internal-nav" aria-label="Navegación del panel administrativo">
                <div class="internal-nav-search">
                    <span aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="5.5"></circle><path d="M15 15l5 5"></path></svg></span>
                    <label class="sr-only" for="internal-menu-search">Buscar una opción del menú</label>
                    <input id="internal-menu-search" type="search" placeholder="Buscar en el menú" autocomplete="off" data-internal-menu-search />
                </div>
                <div class="internal-nav-list" data-internal-menu-list>
                    <asp:Repeater ID="rptMenu" runat="server">
                        <ItemTemplate>
                            <a class="internal-nav-link" href='<%# ResolveUrl(Eval("Url").ToString()) %>'
                                data-menu-name='<%# System.Web.HttpUtility.HtmlAttributeEncode(Eval("Nombre").ToString()) %>'>
                                <span class="internal-nav-icon" aria-hidden="true"><%# ObtenerIconoMenu(Eval("Url")) %></span>
                                <span class="internal-nav-text"><%#: Eval("Nombre") %></span>
                                <%# ObtenerIndicadorPendientes(Eval("Url")) %>
                            </a>
                        </ItemTemplate>
                    </asp:Repeater>
                    <p class="internal-nav-empty" data-internal-menu-empty hidden>No hay opciones con ese nombre.</p>
                </div>
            </nav>

            <main class="internal-content">
                <asp:Panel ID="pnlAvisoRestauracion" runat="server" Visible="false" CssClass="form-message form-message-success aviso-restauracion-base" role="status">
                    Se restauró la base de datos de StageUp desde una copia de seguridad. Tu sesión sigue abierta, pero lo que se haya cargado después de esa copia ya no figura.
                </asp:Panel>
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>

        <asp:HiddenField ID="hdnDiccionarioIdioma" runat="server" ClientIDMode="Static" EnableViewState="false" />
        <script src="<%= ResolveUrl("~/Scripts/multidioma.js") %>?v=20260910-2"></script>
        <script src="<%= ResolveUrl("~/Scripts/stageup-confirm.js") %>?v=20261012-1"></script>
        <script src="<%= ResolveUrl("~/Scripts/charts-stageup.js") %>?v=20261008-1"></script>
        <script src="<%= ResolveUrl("~/Scripts/ui-motion.js") %>?v=20261008-1"></script>
        <script src="<%= ResolveUrl("~/Scripts/internal-menu.js") %>?v=20261022-1"></script>
        <script src="<%= ResolveUrl("~/Scripts/internal-filters.js") %>?v=20261022-2"></script>
    </form>
</body>
</html>
