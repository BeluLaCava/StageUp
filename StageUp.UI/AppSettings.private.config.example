<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA de configuración privada de StageUp.

  Uso:
    1. Copiar este archivo como "AppSettings.private.config" en la misma carpeta
       (StageUp.UI). Web.config lo carga con <appSettings file="AppSettings.private.config">.
    2. Completar cada valor con los datos reales de su entorno.

  IMPORTANTE:
    - AppSettings.private.config está en .gitignore y NUNCA debe commitearse.
    - Este archivo .example sí se versiona y no debe contener ningún valor real.
    - Las claves asimétricas se generan desde Interno > Herramientas de seguridad.
    - La clave simétrica es un valor Base64 de 32 bytes (AES-256). También puede
      definirse con la variable de entorno STAGEUP_CLAVE_ENCRIPTACION.
    - Las claves de reCAPTCHA también pueden definirse con las variables de entorno
      STAGEUP_RECAPTCHA_SITE_KEY / STAGEUP_RECAPTCHA_SECRET_KEY.
    - Asistente automático por API (opcional): con AsistenteApiHabilitado = false
      el asistente del Centro de ayuda deriva directo a soporte cuando no encuentra
      la respuesta. Acepta cualquier API compatible con "chat completions":
        OpenAI:  https://api.openai.com/v1/chat/completions  (clave sk-..., modelo gpt-4o-mini)
        Ollama local (gratis, sin clave): http://localhost:11434/v1/chat/completions  (modelo llama3.2)
      También pueden definirse con STAGEUP_ASISTENTE_API_HABILITADO / _URL / _CLAVE /
      _MODELO / _TIEMPO_MS. El tiempo de espera va de 1000 a 15000 ms (8000 por defecto).
-->
<appSettings>
  <!-- Correo saliente (SMTP) -->
  <add key="SmtpHost" value="smtp.gmail.com" />
  <add key="SmtpPuerto" value="587" />
  <add key="SmtpUsarSsl" value="true" />
  <add key="SmtpUsuario" value="COMPLETAR_CUENTA@gmail.com" />
  <add key="SmtpPassword" value="COMPLETAR_CONTRASENA_DE_APLICACION" />
  <add key="CorreoRemitente" value="COMPLETAR_CUENTA@gmail.com" />
  <add key="NombreRemitente" value="StageUp" />

  <!-- Google reCAPTCHA v2 -->
  <add key="RecaptchaSiteKey" value="COMPLETAR_SITE_KEY" />
  <add key="RecaptchaSecretKey" value="COMPLETAR_SECRET_KEY" />

  <!-- Encriptación simétrica (AES) -->
  <add key="ClaveEncriptacionSimetrica" value="COMPLETAR_CLAVE_BASE64_32_BYTES" />

  <!-- Encriptación asimétrica (RSA 2048) - generar desde Interno > Herramientas de seguridad -->
  <add key="ClaveAsimetricaPublica" value="COMPLETAR_CLAVE_PUBLICA_BASE64" />
  <add key="ClaveAsimetricaPrivada" value="COMPLETAR_CLAVE_PRIVADA_BASE64" />

  <!-- Asistente automático de soporte por API (opcional) -->
  <add key="AsistenteApiHabilitado" value="false" />
  <add key="AsistenteApiUrl" value="https://api.openai.com/v1/chat/completions" />
  <add key="AsistenteApiClave" value="COMPLETAR_CLAVE_API" />
  <add key="AsistenteApiModelo" value="gpt-4o-mini" />
  <add key="AsistenteApiTiempoEsperaMs" value="8000" />
</appSettings>
