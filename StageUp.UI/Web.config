<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="StageUpConnectionString"
         connectionString="Data Source=localhost;Initial Catalog=StageUp;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
	</connectionStrings>
  <appSettings file="AppSettings.private.config">
    <add key="EspaciosFichaCompletaHabilitada" value="true" />
    <add key="PerfilCompletoHabilitado" value="true" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <sessionState mode="InProc" timeout="30" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/ErrorGeneral.aspx">
      <error statusCode="404" redirect="~/PaginaNoEncontrada.aspx" />
    </customErrors>
  </system.web>
  <system.webServer>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/PaginaNoEncontrada.aspx" responseMode="ExecuteURL" />
      <remove statusCode="500" />
      <error statusCode="500" path="/ErrorGeneral.aspx" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
